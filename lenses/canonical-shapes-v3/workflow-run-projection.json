{
  "lexicon": 1,
  "id": "app.graycard.workflow.run",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["createdAt"],
        "properties": {
          "createdAt": { "type": "string", "format": "datetime" },
          "photo": { "type": "string", "format": "at-uri" },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "type": "string" },
                "ref": { "type": "string", "format": "at-uri" }
              }
            }
          }
        }
      }
    }
  }
}
