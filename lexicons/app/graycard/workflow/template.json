{
  "lexicon": 1,
  "id": "app.graycard.workflow.template",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "medium", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "medium": {
            "type": "ref",
            "ref": "app.graycard.workflow.defs#medium"
          },
          "steps": {
            "type": "array",
            "maxLength": 256,
            "description": "Ordered, stable-ID template steps. Repeated kinds are distinguished by each step's id.",
            "items": { "type": "ref", "ref": "app.graycard.workflow.defs#templateStep" }
          },
          "connections": {
            "type": "array",
            "maxLength": 512,
            "description": "Directed artifact-flow graph over named step ports. The graph must be acyclic.",
            "items": { "type": "ref", "ref": "app.graycard.workflow.defs#templateConnection" }
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "links": {
            "type": "ref",
            "ref": "app.graycard.defs#catalogLinks"
          }
        }
      },
      "description": "A reusable workflow template with stable ordered steps, typed defaults, and explicit artifact-flow topology."
    }
  }
}
