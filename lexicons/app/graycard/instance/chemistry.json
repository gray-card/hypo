{
  "lexicon": 1,
  "id": "app.graycard.instance.chemistry",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["type", "createdAt"],
        "properties": {
          "type": {
            "type": "string",
            "format": "at-uri",
            "description": "app.graycard.catalog.chemistryType"
          },
          "componentName": {
            "type": "string",
            "maxLength": 128,
            "description": "For a process kit, the particular bath or component represented by this instance. Separate instances allow each mixed bath to have its own lifecycle dates."
          },
          "nickname": {
            "type": "string",
            "maxLength": 64
          },
          "dilution": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "knownValues": ["unopened", "active", "exhausted", "discarded"],
            "description": "Current lifecycle state of this chemistry instance."
          },
          "acquiredAt": {
            "type": "string",
            "format": "datetime"
          },
          "openedAt": {
            "type": "string",
            "format": "datetime"
          },
          "mixedAt": {
            "type": "string",
            "format": "datetime"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime"
          },
          "volumeMl": {
            "type": "integer",
            "minimum": 0
          },
          "volumeRemainingMl": {
            "type": "integer",
            "minimum": 0
          },
          "rollsProcessed": {
            "type": "integer",
            "minimum": 0
          },
          "sessionsUsed": {
            "type": "integer",
            "minimum": 0
          },
          "maxRollsRecommended": {
            "type": "integer",
            "minimum": 0,
            "description": "Manufacturer or user limit before replenishment or discard."
          },
          "storageLocation": {
            "type": "string",
            "format": "at-uri"
          },
          "replenishedAt": {
            "type": "string",
            "format": "datetime"
          },
          "exhaustedAt": {
            "type": "string",
            "format": "datetime"
          },
          "discardedAt": {
            "type": "string",
            "format": "datetime"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "image": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 3000000,
            "description": "Optional user photo of this specific item; falls back to the catalog type's stock image."
          }
        }
      },
      "description": "A specific photographic chemical, working solution, or separately tracked bath from a process kit. References catalog.chemistryType."
    }
  }
}
