{
  "name": "hypo",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "description": "Hypo: a photographic metadata tool that writes portable app.graycard.* records to your atproto PDS and integrates with grain.social.",
  "license": "MIT",
  "author": "Aaron Steven White",
  "homepage": "https://hypo.graycard.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/gray-card/hypo.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:catalog-shards",
    "dev": "vite",
    "prebuild": "npm run build:catalog-shards",
    "build": "vite build",
    "preview": "vite preview",
    "build:catalog": "node scripts/build-catalog.mjs --wikidata",
    "build:catalog-shards": "node scripts/build-catalog-shards.mjs",
    "build:tokenizer": "node --max-old-space-size=24576 scripts/build-tokenizer.mjs",
    "build:caption-idf": "node --max-old-space-size=4096 scripts/build-caption-idf.mjs",
    "eval:tokenizer": "node scripts/eval-tokenizer.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:lexicons": "node scripts/generate-lexicons.mjs",
    "check:lexicons": "npm run generate:lexicons && git diff --exit-code -- packages/lexicon/src/generated.ts packages/lexicon/src/namespaces.ts",
    "generate:lexicon-docs": "node scripts/generate-lexicon-docs.mjs",
    "check:lexicon-docs": "npm run generate:lexicon-docs && git diff --exit-code -- docs/reference/lexicons docs/site/generated/lexiconSidebar.mjs docs/site/src/data/lexicon-summary.json",
    "generate:panproto-conformance": "node scripts/check-panproto-conformance.mjs --write",
    "check:panproto-conformance": "node scripts/check-panproto-conformance.mjs",
    "check:panproto": "node scripts/check-panproto.mjs && npm run check:panproto-conformance",
    "check:panproto-pr": "node scripts/check-panproto-pr.mjs",
    "check:ios-docs": "node apps/ios/Scripts/check-documentation.mjs",
    "docs:dev": "npm run generate:lexicon-docs && npm run check:ios-docs && docusaurus start docs/site",
    "docs:build": "npm run generate:lexicon-docs && npm run check:ios-docs && docusaurus build docs/site",
    "docs:build:ios-api": "npm run check:ios-docs && apps/ios/Scripts/build-documentation.sh docs/site/static/ios-api",
    "docs:build:combined": "npm run docs:build:ios-api && npm run docs:build",
    "docs:serve": "docusaurus serve docs/site",
    "size": "size-limit && node scripts/check-chunk-budgets.mjs",
    "lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:pds-real": "tsx scripts/pds-real-smoke.ts",
    "test:store": "vitest run tests/store-signals.test.ts",
    "check:release": "npm run check:panproto && npm run check:lexicons && npm run check:lexicon-docs && npm run typecheck && npm test && npm run test:e2e && npm run lint && npm run format:check && npm run build && npm run docs:build && npm run size && npm run lighthouse",
    "typecheck": "tsc --build --pretty false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource-variable/space-grotesk": "^5.1.1",
    "@panproto/core": "0.70.1",
    "exifr": "^7.1.3",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@atproto/dev-env": "0.5.23",
    "@changesets/cli": "^3.0.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@lhci/cli": "0.15.1",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^11.2.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "webpack": "5.106.0"
  }
}
